# ============================================================
# Data Files (Importantes para ML)
# ============================================================
# Raw data (generalmente grande y debe estar en otro lugar)
data/raw/*
data/raw/**/*
!data/raw/.gitkeep
!data/raw/README.md

# Processed data (resultados intermedios)
data/processed/*
data/processed/**/*
!data/processed/.gitkeep
!data/processed/README.md

# External data
data/external/*
data/external/**/*
!data/external/.gitkeep
!data/external/README.md

# Sample/demo data pequeña (puedes permitir algunos ejemplos pequeños)
# !data/raw/sample_*.csv
# !data/raw/demo_*.json

# Common data formats
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.mat

# Exceptions for small config/reference data
!*_config.csv
!*_reference.csv

# Database files
*.db
*.sqlite
*.sqlite3

# ============================================================
# Models & Checkpoints
# ============================================================
# Saved models (generalmente muy grandes)
models/saved_models/*
models/saved_models/**/*
!models/saved_models/.gitkeep
!models/saved_models/README.md

# Experiments
models/experiments/*
models/experiments/**/*
!models/experiments/.gitkeep
!models/experiments/README.md

# Checkpoints
checkpoints/
*.ckpt
*.pth
*.pt
*.weights
*.h5

# Model artifacts
*.onnx
*.pb
*.tflite


# Environment Configuration
ENVIRONMENT=development

# Paths
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs

# Data Sources
RAW_DATA_PATH=data/raw/transactions.csv
PROCESSED_DATA_PATH=data/processed/processed_data.parquet

# Model Configuration
MODEL_TYPE=xgboost
RANDOM_SEED=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# MLflow Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fraud-detection

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Engineering
N_JOBS=-1
USE_GPU=false

# Model Thresholds
FRAUD_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.8
AUTO_DECLINE_THRESHOLD=0.95

# Business Metrics (CRÍTICO para optimización)
FRAUD_COST_PER_TRANSACTION=100.0
FALSE_POSITIVE_COST=5.0
REVIEW_CAPACITY_PER_DAY=1000
PRECISION_TARGET=0.80
RECALL_TARGET=0.70

# Class Balancing
USE_SMOTE=true
SMOTE_SAMPLING_STRATEGY=0.5
USE_CLASS_WEIGHTS=true

# Temporal Validation
USE_TEMPORAL_SPLIT=true
TEMPORAL_SPLIT_DATE=2024-01-01
EMBARGO_DAYS=7

# Feature Engineering
AGGREGATION_WINDOWS=1,7,30
VELOCITY_WINDOWS=1,6,24
MIN_TRANSACTIONS_FOR_AGGREGATION=5

# Monitoring
ENABLE_DRIFT_DETECTION=true
DRIFT_THRESHOLD=0.1
PERFORMANCE_DEGRADATION_THRESHOLD=0.05

# API Configuration (if deploying)
API_HOST=0.0.0.0
API_PORT=8000

# Database (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/fraud_db

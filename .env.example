# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Random seed
RANDOM_SEED=42

# Parallelism
N_JOBS=-1

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=pbp_productionDB_optimized
CLICKHOUSE_SECURE=false

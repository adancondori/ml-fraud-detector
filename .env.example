# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Random seed
RANDOM_SEED=42

# Parallelism
N_JOBS=-1

# ClickHouse READ target (production, read-only).
# Used for cursor resolution, payment fetch, batch context and single-score
# context. NEVER point this at a writable production user.
CLICKHOUSE_HOST=your-clickhouse-cloud-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=your-prod-readonly-user
CLICKHOUSE_PASSWORD=your-prod-readonly-password
CLICKHOUSE_DATABASE=pbp_productionDB_optimized
CLICKHOUSE_SECURE=true

# ClickHouse WRITE target (LOCAL) — where anomaly_scores are inserted.
# Defaults point at the local docker service; the batch guardrail aborts if
# this resolves to the same connection as READ or to a non-local host.
ANOMALY_SCORES_CH_HOST=clickhouse
ANOMALY_SCORES_CH_PORT=8123
ANOMALY_SCORES_CH_USER=default
ANOMALY_SCORES_CH_PASSWORD=
ANOMALY_SCORES_CH_DATABASE=pbp_productionDB_optimized
ANOMALY_SCORES_CH_SECURE=false

# Destination table for the INSERT (local reuses the prod DB *name*).
ANOMALY_SCORES_TABLE=pbp_productionDB_optimized.anomaly_scores

# Off-by-default escape hatch to allow writing anomaly_scores to a non-local
# host. Leave false for the local integration run.
ALLOW_NONLOCAL_ANOMALY_SCORE_WRITES=false

# Model paths
# MODEL_DIR: path to the directory containing model artifacts.
# In Docker the Dockerfile sets MODEL_DIR=/app/output/models; override here only if needed.
MODEL_DIR=output/models

# Shadow model (optional): set to a directory with a DIFFERENT model_metadata.json
# to run IF-40 shadow scoring alongside the active model.
# Leave empty to disable shadow mode.
SHADOW_MODEL_DIR=
